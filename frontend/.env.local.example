# Backend URL (leave empty in dev — Next.js rewrites /api/* to localhost:8000)
NEXT_PUBLIC_API_URL=

# Separate public Maps JavaScript API key, restricted by website referrer.
# Never use the server Places/Routes key here.
# Set this in Vercel dashboard for production; copy to .env.local for local dev
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps Map ID — enables AdvancedMarker and custom Cloud-configured styles.
# Defaults to DEMO_MAP_ID (supports AdvancedMarker, uses Google's standard style).
# To apply custom map styling: create a Map ID in Cloud Console → Maps → Map styles,
# configure the style there, then set this to the Map ID string.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Enable only after production HTTPS is verified.
SECURITY_HSTS_ENABLED=false
