# Server-side key: restrict to Places API (New) and Routes API.
# Never reuse the browser's Maps JavaScript key here.
GOOGLE_MAPS_API_KEY=
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# Production requires rediss:// (TLS, certificate + hostname verified) shared by
# every replica; plaintext redis:// is refused at startup. memory:// is dev-only.
RATE_LIMIT_STORAGE_URI=memory://
# Exact connection-peer IPs/CIDRs of proxies that sanitize X-Forwarded-For.
# Empty means forwarded headers are ignored. Do not configure hop counts.
TRUSTED_PROXY_IPS=
RATE_LIMIT_WHITELIST_IPS=
MAX_STOPS_PER_REQUEST=12
MAX_REQUESTS_PER_IP_PER_DAY=50
MAX_REQUESTS_PER_IP_PER_MINUTE=10
PROVIDER_CALLS_PER_DAY=2000
MAX_REQUEST_BYTES=16384
MAX_CONCURRENT_REQUESTS=20
MAX_CONCURRENT_PROVIDER_CALLS=20
PROVIDER_WAIT_SECONDS=2

CACHE_DB_PATH=./cache/places_cache.db
CACHE_TTL_DAYS=30
CACHE_CLEANUP_SECONDS=3600
# Enable only after HTTPS is working on the production domain.
HSTS_ENABLED=false
